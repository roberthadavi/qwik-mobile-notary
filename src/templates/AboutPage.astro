---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import { NOTARY_HUBS, OTHER_HUBS, hubPath, type Lang } from '../data/catalog';
import { SITE, PATHS, t } from '../data/site';
import { ABOUT } from '../data/pages';
interface Props { lang: Lang }
const { lang } = Astro.props;
const alt: Lang = lang === 'en' ? 'es' : 'en';
const jsonLd: object[] = [];
if (SITE.notary.name) {
  jsonLd.push({ '@context': 'https://schema.org', '@type': 'Person', name: SITE.notary.name, jobTitle: 'Notary Public', worksFor: { '@id': `${SITE.url}/#organization` }, url: new URL(PATHS.about[lang], SITE.url).href, address: { '@type': 'PostalAddress', addressLocality: 'El Paso', addressRegion: 'TX' }, knowsLanguage: ['en', 'es'] });
}
---
<Base lang={lang} title={ABOUT.title[lang]} description={ABOUT.metaDescription[lang]} path={PATHS.about[lang]} altPath={PATHS.about[alt]} jsonLd={jsonLd}>
  <section class="hero hero-inner on-dark">
    <div class="container">
      <div class="hero-copy">
        <nav class="crumbs" aria-label={t('breadcrumbAria', lang)}><ol><li><a href={PATHS.home[lang]}>{t('home', lang)}</a></li><li aria-current="page">{t('about', lang)}</li></ol></nav>
        <div class="eyebrow gold">{ABOUT.eyebrow[lang]}</div>
        <h1>{ABOUT.h1[lang]}</h1>
        <p class="lede">{ABOUT.lede[lang]}</p>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container about-grid">
      <div>
        <figure class="portrait">
          <img src={SITE.notary.photo} srcset={`${SITE.notary.photoSmall} 640w, ${SITE.notary.photo} 1040w`} sizes="(max-width: 860px) 100vw, 40vw" width="1040" height="1300" alt={SITE.notary.photoAlt[lang]} loading="eager" decoding="async" />
          <figcaption>{SITE.notary.photoCaption[lang]}</figcaption>
        </figure>
        <div class="aside-box" style="margin-top:1.25rem">
          <ul>{ABOUT.facts.map((f) => <li><b style="display:block;font-size:.7rem;text-transform:uppercase;letter-spacing:.1em;color:var(--muted-text)">{f.k[lang]}</b>{typeof f.v === 'string' ? f.v : f.v[lang]}</li>)}</ul>
        </div>
      </div>
      <div class="prose">
        {ABOUT.body[lang].map((p) => <p>{p}</p>)}
        <h2>{t('services', lang)}</h2>
        <ul>{NOTARY_HUBS.map((h) => <li><a href={hubPath(h, lang)}>{h.icon} {h.name[lang]}</a></li>)}{OTHER_HUBS.map((h) => <li><a href={hubPath(h, lang)}>{h.icon} {h.name[lang]}</a></li>)}</ul>
        <p><a href={PATHS.fees[lang]}>{t('seeFees', lang)} →</a> · <a href={PATHS.serviceArea[lang]}>{t('serviceArea', lang)} →</a></p>
      </div>
    </div>
  </section>
  <CtaBand lang={lang} />
</Base>
