---
// /photos/ — staff review gallery for the first September 2026 shoot (173 photos from David's Desktop "photos" folder).
import GalleryPage from '../../templates/GalleryPage.astro';
import data from '../../data/photos.json';
const { groups, items } = data as { groups: { id: string; title: string; count: number }[]; items: { file: string; w: number; h: number; group: string; caption: string }[] };
---
<GalleryPage
  base="/photos"
  shoot="the September 2026 shoot"
  titleLabel="Sept 2026 Shoot"
  descriptionScope="courts and downtown El Paso, the law office and team, The Mission Business Center"
  short={{ courts: 'Courts & downtown', office: 'Law office & team', mission: 'Mission Business Center' }}
  groups={groups}
  items={items}
  originals="the photos folder on David's desktop"
  storageKey="qwik-photo-stars"
/>
