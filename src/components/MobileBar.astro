---
// Fixed bottom action bar, phones/tablets only (hidden ≥ 981px where the full nav is visible).
// "Call now" dials the business; "Contact" goes to the contact page (or jumps to the form when already there).
import { SITE, PATHS, t } from '../data/site';
import type { Lang } from '../data/catalog';
interface Props { lang: Lang; path: string }
const { lang, path } = Astro.props;
const onContact = path.replace(/\/+$/, '') === PATHS.contact[lang].replace(/\/+$/, '');
const contactHref = onContact ? '#lead-form' : PATHS.contact[lang];
---
<nav class="mobile-bar" aria-label={t('mobileBarLabel', lang)}>
  <a class="mb-call" href={SITE.phoneHref}>
    <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
    <span>{t('mobileCall', lang)}</span>
  </a>
  <a class="mb-contact" href={contactHref}>
    <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
    <span>{t('contact', lang)}</span>
  </a>
</nav>
