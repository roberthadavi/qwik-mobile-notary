---
import type { Lang, L } from '../data/catalog';
import { t } from '../data/site';
interface Props { lang: Lang; faqs: { q: L; a: L }[]; eyebrow?: string; heading?: string; }
const { lang, faqs, eyebrow = t('faq', lang), heading = t('commonQuestions', lang) } = Astro.props;
---
<section class="section bg-white" id="faq">
  <div class="narrow">
    <div class="section-head">
      <div class="eyebrow">{eyebrow}</div>
      <h2>{heading}</h2>
    </div>
    <div class="faq">
      {faqs.map((f) => (
        <details>
          <summary>{f.q[lang]}</summary>
          <div class="a"><p>{f.a[lang]}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>
