{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qwik-mobile-notary",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // Must be `true`: with a route list, requests that miss the list AND miss an asset never reach the
    // Worker (they get the 404 page), so the legacy 301s, www→apex and the workers.dev noindex header
    // would silently not run. The Worker calls env.ASSETS.fetch() for everything it doesn't redirect.
    "run_worker_first": true
  },
  "observability": { "enabled": true },
  "vars": {
    // Pre-launch: send leads to David; remove at cutover so the default (qwikmobilenotary@gmail.com) applies.
    "LEAD_TO_EMAIL": "david@trafficfirm.org"
  }
}
